{
  "rules": [
    {
      "message": "control.rotary_tooltip",
      "match": "点击设置旋钮\\n逆时针 · (.*?)（(.*?)）\\n顺时针 · (.*?)（(.*?)）\\n按 · (.*?)（(.*?)）",
      "translate": [
        1,
        3,
        5
      ]
    },
    {
      "message": "control.joystick_tooltip",
      "match": "点击设置摇杆\\n↑/↓ · (.*?)（(.*?)）\\n←/→ · (.*?)（(.*?)）\\n按 · (.*?)（(.*?)）",
      "split": {
        "1": "/",
        "3": "/"
      },
      "translate": [
        5
      ]
    },
    {
      "message": "control.tooltip_details",
      "match": "点击设置([^\\n]+)\\n(.+)",
      "translate": [
        1
      ],
      "split": {
        "2": "\n"
      }
    },
    {
      "message": "control.action_row",
      "match": "(逆时针|顺时针|按|↑/↓|←/→) · (.*?)（(.*?)）",
      "translate": [
        1,
        2
      ]
    },
