CONFIG_MACROPAD_BOARD_DEVKIT_BOOT_BUTTON=n
CONFIG_MACROPAD_BOARD_TARGET_REV_A=n
CONFIG_MACROPAD_BOARD_MATRIX12_V1=n
CONFIG_MACROPAD_BOARD_MATRIX12_POWER_V2=y
# ESP32-S3-WROOM-1-N16R8: 16 MB flash and 8 MB embedded PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Config canonicalization uses ordinary calloc for its 16 KiB buffer. Allow
# these allocations to use PSRAM; CAPS_ALLOC alone leaves them in internal RAM.
CONFIG_SPIRAM_USE_MALLOC=y
# Full-frame icon snapshots must not consume the internal heap needed by BLE.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Enable DFS support for the product target. app_main configures the exact
# 80-160 MHz range; automatic light sleep remains disabled.
CONFIG_PM_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=8
CONFIG_ESP_SECURE_CERT_DS_PERIPHERAL=y
CONFIG_MBEDTLS_HARDWARE_RSA_DS_PERIPHERAL=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
